//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  Wick CE + Engineered Liquidity Strategy  (MarketNQ course model)
//
//  Setup 1 : qualified HTF rejection wick + engineered liquidity before its CE
//            -> direct limit at the wick CE, stop beyond the wick extreme.
//  Setup 2 : same qualified HTF wick, price reaches the CE, then a chart-TF
//            rejection block forms -> limit at that smaller wick's beginning/CE,
//            stop beyond the smaller wick extreme.
//
//  Destination (draw on liquidity) = untaken prior-day extreme in the direction
//  of the daily-context bias (or a fixed R multiple).
//
//  Educational tool. Backtest results do not establish a win rate or expectancy.
// ═══════════════════════════════════════════════════════════════════════════════
strategy("Wick CE + Engineered Liquidity Strategy", shorttitle = "WickCE Strat", overlay = true,
     initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 2.0, slippage = 1,
     pyramiding = 0, max_lines_count = 500, max_labels_count = 500, max_bars_back = 2000)

// ───────────────────────────── Inputs ─────────────────────────────
const string SETUP1 = "Setup 1 - Direct wick CE"
const string SETUP2 = "Setup 2 - LTF rejection block"
const string TGT_PD = "Prior day extreme"
const string TGT_R  = "Fixed R multiple"

grpM = "Model"
setupMode  = input.string(SETUP1, "Entry route", options = [SETUP1, SETUP2], group = grpM)
htfTf      = input.timeframe("240", "HTF location timeframe (wick)", group = grpM, tooltip = "Timeframe of the rejection wick (H4 by default). Must be higher than the chart (execution) timeframe.")
biasMode   = input.string("Daily context", "Direction filter", options = ["Daily context", "Both directions", "Long only", "Short only"], group = grpM,
     tooltip = "Daily context: prior-high sweep + close back inside = bearish; prior-low sweep + close back inside = bullish; close beyond a prior extreme = continuation.")
targetMode = input.string(TGT_PD, "Destination (draw on liquidity)", options = [TGT_PD, TGT_R], group = grpM,
     tooltip = "Prior day extreme: shorts target the untaken prior-day low, longs the untaken prior-day high. Setup is skipped if that destination already traded.")
fixedR     = input.float(4.0, "Fixed R target", minval = 0.5, step = 0.5, group = grpM)
minRR      = input.float(2.0, "Minimum planned R to take the trade", minval = 0, step = 0.25, group = grpM)

grpW = "HTF wick qualification"
originMode = input.string("Sweep required", "Wick origin", options = ["Sweep required", "Any qualified wick"], group = grpW,
     tooltip = "Sweep required: the wick must take out the highest high / lowest low of the previous N HTF candles and close back inside.")
sweepLen   = input.int(6, "Sweep lookback (HTF candles)", minval = 1, group = grpW)
minWickPts = input.float(10.0, "Min wick size (points)", minval = 0, group = grpW)
minWickPct = input.float(30.0, "Min wick % of candle range", minval = 0, maxval = 100, group = grpW)
useFvgFilt = input.bool(true, "Exclude wick that begins an unfilled imbalance", group = grpW,
     tooltip = "Waits two HTF candles after the wick and discards it if the wick candle became the first candle of a fair value gap.")
useEqFilt  = input.bool(true, "Exclude wick forming equal highs / lows", group = grpW)
eqTol      = input.float(1.0, "Equal swing tolerance (points)", minval = 0, group = grpW)
maxHtfAge  = input.int(6, "Setup expires after N HTF candles", minval = 1, group = grpW)

grpL = "Engineered liquidity (chart timeframe)"
pivLen     = input.int(3, "Swing pivot strength (bars each side)", minval = 1, group = grpL)
minLiq     = input.int(2, "Min swing points before CE (grouped liquidity)", minval = 1, group = grpL)
proxPts    = input.float(2.0, "Proximity exclusion: pool within X points of CE", minval = 0, group = grpL,
     tooltip = "A pool this close to CE treats the midpoint as already mitigated and the setup is discarded.")
liqMaxDist = input.float(60.0, "Max pool distance from CE (points)", minval = 1, group = grpL)

grpS2 = "Setup 2 - LTF rejection block"
ltfMinPts  = input.float(3.0, "Min rejection wick (points)", minval = 0, group = grpS2)
ltfMinPct  = input.float(40.0, "Min rejection wick % of candle range", minval = 0, maxval = 100, group = grpS2)
ltfDirCls  = input.bool(true, "Rejection candle must close in trade direction", group = grpS2)
ltfRef     = input.string("Wick CE (50%)", "Entry reference", options = ["Wick CE (50%)", "Wick beginning"], group = grpS2)
ltfWait    = input.int(12, "Bars to wait for rejection after CE reached", minval = 1, group = grpS2)

grpR = "Risk & sizing"
stopBuf    = input.float(1.0, "Stop buffer beyond structure (points)", minval = 0, group = grpR)
maxStopPts = input.float(60.0, "Max stop distance (points, 0 = off)", minval = 0, group = grpR)
sizeMode   = input.string("Fixed contracts", "Position sizing", options = ["Fixed contracts", "Fixed cash risk"], group = grpR,
     tooltip = "Fixed cash risk: qty = floor(risk / (stop distance x point value)). Trade skipped if qty < 1.")
fixedQty   = input.float(1, "Contracts", minval = 1, step = 1, group = grpR)
riskCash   = input.float(500, "Cash risk per trade", minval = 1, group = grpR)
orderExp   = input.int(48, "Cancel unfilled limit after N bars", minval = 1, group = grpR)

grpMg = "Management"
beAtR      = input.float(0.0, "Move stop to break-even at R (0 = off)", minval = 0, step = 0.25, group = grpMg)
useTrail   = input.bool(false, "Structural trail (swing confirmed by break of intervening swing)", group = grpMg)

grpD = "Session & discipline"
useSess    = input.bool(true, "Only place new orders inside session", group = grpD)
sessStr    = input.session("0700-1600", "Session", group = grpD)
sessTz     = input.string("America/New_York", "Session timezone", group = grpD)
maxTrades  = input.int(2, "Max trades per day", minval = 1, group = grpD)
maxLosses  = input.int(2, "Stop for the day after N losses", minval = 1, group = grpD)

grpV = "Visuals"
showLevels = input.bool(true, "Draw wick beginning / CE / extreme", group = grpV)
showPD     = input.bool(true, "Plot prior-day high / low", group = grpV)
showTable  = input.bool(true, "Status table", group = grpV)
colBear    = input.color(color.new(#f23645, 0), "Bearish", group = grpV)
colBull    = input.color(color.new(#089981, 0), "Bullish", group = grpV)
colLiq     = input.color(color.new(#ff9800, 0), "Liquidity", group = grpV)

if barstate.isfirst and timeframe.in_seconds(htfTf) <= timeframe.in_seconds()
    runtime.error("HTF location timeframe must be higher than the chart timeframe.")

// ───────────────────────────── Constants ─────────────────────────────
const int S_LIQ   = 1   // waiting for engineered liquidity
const int S_READY = 2   // qualified; setup 1 places order / setup 2 waits for CE
const int S_LTF   = 3   // setup 2: CE reached, waiting for chart-TF rejection
const int S_ORDER = 4   // limit order working
const int S_DONE  = 5   // filled, invalidated or expired

// ───────────────────────────── HTF data (non-repainting) ─────────────────────────────
f_htf() =>
    priorHi = ta.highest(high, sweepLen)[1]
    priorLo = ta.lowest(low, sweepLen)[1]
    [open[1], high[1], low[1], close[1], time[1], priorHi[1], priorLo[1], high[3], low[3], time[3]]

[hO, hH, hL, hC, hT, hPH, hPL, h3H, h3L, h3T] = request.security(syminfo.tickerid, htfTf, f_htf(), lookahead = barmerge.lookahead_on)
newHtf = not na(hT) and hT != nz(hT[1])

// ───────────────────────────── Daily context ─────────────────────────────
[pdH, pdL, pdC, ppH, ppL] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], high[2], low[2]], lookahead = barmerge.lookahead_on)

bearSweep = pdH > ppH and pdC < ppH
bullSweep = pdL < ppL and pdC > ppL
bullCont  = pdC > ppH
bearCont  = pdC < ppL
int dailyBias = bearSweep and not bullSweep ? -1 : bullSweep and not bearSweep ? 1 : bullCont ? 1 : bearCont ? -1 : 0

allowLong  = biasMode == "Both directions" or biasMode == "Long only"  or (biasMode == "Daily context" and dailyBias == 1)
allowShort = biasMode == "Both directions" or biasMode == "Short only" or (biasMode == "Daily context" and dailyBias == -1)

newDay = ta.change(time("D")) != 0
var float dayHi = na
var float dayLo = na
var int tradesToday = 0
var int lossesToday = 0
if newDay
    dayHi := high
    dayLo := low
    tradesToday := 0
    lossesToday := 0
else
    dayHi := math.max(nz(dayHi, high), high)
    dayLo := math.min(nz(dayLo, low), low)

// trade / loss counters (global so they can be mutated)
var int prevTotal  = 0
var int prevClosed = 0
int totalTrades = strategy.closedtrades + strategy.opentrades
if totalTrades > prevTotal
    tradesToday += totalTrades - prevTotal
    prevTotal := totalTrades
if strategy.closedtrades > prevClosed
    for i = prevClosed to strategy.closedtrades - 1
        if strategy.closedtrades.profit(i) < 0
            lossesToday += 1
    prevClosed := strategy.closedtrades

dayLocked = tradesToday >= maxTrades or lossesToday >= maxLosses
inSess    = not useSess or not na(time(timeframe.period, sessStr, sessTz))

// ───────────────────────────── Chart-TF swings ─────────────────────────────
ph   = ta.pivothigh(high, pivLen, pivLen)
pl   = ta.pivotlow(low, pivLen, pivLen)
pivT = time[pivLen]

// ───────────────────────────── Setup object ─────────────────────────────
type Setup
    int    dir
    int    state      = 5
    int    wickTime
    int    startTime
    int    startBar
    float  beg
    float  ce
    float  ext
    float  target
    int    liqCount   = 0
    float  liqLevel
    bool   fvgChecked = false
    int    htfAge     = 0
    int    reachBar
    int    orderBar
    float  entry
    float  stop
    float  tp
    string id         = ""
    string note       = ""
    line   lBeg
    line   lCe
    line   lExt
    line   lTgt

method alive(Setup s) =>
    s.state >= S_LIQ and s.state <= S_ORDER

method kill(Setup s, string why) =>
    if s.state == S_ORDER
        strategy.cancel(s.id)
    s.state := S_DONE
    s.note  := why
    if not na(s.lCe)
        s.lCe.set_x2(time)
        s.lBeg.set_x2(time)
        s.lExt.set_x2(time)
        s.lCe.set_style(line.style_dotted)
    if not na(s.lTgt)
        s.lTgt.set_x2(time)
    s

method extendLines(Setup s) =>
    if s.alive() and not na(s.lCe)
        s.lCe.set_x2(time)
        s.lBeg.set_x2(time)
        s.lExt.set_x2(time)
        if not na(s.lTgt)
            s.lTgt.set_x2(time)
    s

f_newSetup(int d, int wt, float beg, float ext, float tgt) =>
    Setup s = Setup.new(dir = d, state = S_LIQ, wickTime = wt, startTime = time, startBar = bar_index,
         beg = beg, ce = (beg + ext) / 2, ext = ext, target = tgt, fvgChecked = not useFvgFilt,
         id = (d == 1 ? "Long " : "Short ") + str.tostring(bar_index), note = "Waiting for liquidity")
    if showLevels
        color c = d == 1 ? colBull : colBear
        s.lExt := line.new(wt, ext, time, ext, xloc = xloc.bar_time, color = c, width = 1)
        s.lCe  := line.new(wt, s.ce, time, s.ce, xloc = xloc.bar_time, color = c, width = 2, style = line.style_dashed)
        s.lBeg := line.new(wt, beg, time, beg, xloc = xloc.bar_time, color = color.new(c, 60), width = 1)
        if targetMode == TGT_PD
            s.lTgt := line.new(time, tgt, time, tgt, xloc = xloc.bar_time, color = color.new(c, 30), width = 1, style = line.style_dotted)
        label.new(wt, ext, "HTF wick CE " + str.tostring(s.ce, format.mintick), xloc = xloc.bar_time,
             style = d == 1 ? label.style_label_up : label.style_label_down, color = color.new(c, 75),
             textcolor = chart.fg_color, size = size.tiny)
    s

// Size, validate and place the limit + bracket for a chosen entry structure.
method planOrder(Setup s, float entryPx, float stopPx, string route) =>
    float risk = math.abs(entryPx - stopPx)
    float tp   = targetMode == TGT_R ? entryPx + s.dir * risk * fixedR : s.target
    float rr   = risk > 0 ? s.dir * (tp - entryPx) / risk : 0.0
    float qty  = sizeMode == "Fixed contracts" ? fixedQty : risk > 0 ? math.floor(riskCash / (risk * syminfo.pointvalue)) : 0.0
    bool stopOk = maxStopPts == 0 or risk <= maxStopPts
    if risk <= 0 or rr < minRR
        s.kill("Pass: planned R " + str.tostring(rr, "#.##") + " < min")
    else if not stopOk
        s.kill("Pass: stop " + str.tostring(risk, "#.##") + " pts too wide")
    else if qty < 1
        s.kill("Pass: size < 1 contract")
    else
        s.entry    := entryPx
        s.stop     := stopPx
        s.tp       := tp
        s.state    := S_ORDER
        s.orderBar := bar_index
        s.note     := route + " limit working"
        strategy.entry(s.id, s.dir == 1 ? strategy.long : strategy.short, qty = qty, limit = entryPx, comment = route)
        strategy.exit(s.id + " x", from_entry = s.id, stop = stopPx, limit = tp, comment_loss = "SL", comment_profit = "TP")
        color c = s.dir == 1 ? colBull : colBear
        label.new(bar_index, entryPx, route + (s.dir == 1 ? " LONG" : " SHORT") +
             "\nEntry " + str.tostring(entryPx, format.mintick) +
             "\nSL " + str.tostring(stopPx, format.mintick) + " (" + str.tostring(risk, "#.##") + " pts)" +
             "\nTP " + str.tostring(tp, format.mintick) + " (" + str.tostring(rr, "#.##") + "R)" +
             "\nQty " + str.tostring(qty),
             style = label.style_label_left, color = color.new(c, 20), textcolor = color.white, size = size.small)
        alert(syminfo.ticker + " " + route + (s.dir == 1 ? " LONG" : " SHORT") + " limit " + str.tostring(entryPx, format.mintick) +
             " SL " + str.tostring(stopPx, format.mintick) + " TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)
    s

// Advance one setup through its state machine on the current bar.
method step(Setup s, bool canTrade) =>
    if s.alive()
        int d = s.dir
        bool through  = d == -1 ? high > s.ext : low < s.ext
        bool ceTouch  = d == -1 ? high >= s.ce : low <= s.ce
        bool tgtTaken = targetMode == TGT_PD and (d == -1 ? low <= s.target : high >= s.target)

        // HTF bookkeeping: age + unfilled-imbalance-origin filter
        if newHtf and bar_index > s.startBar
            s.htfAge := s.htfAge + 1
            if s.wickTime == h3T
                if useFvgFilt and (d == -1 ? h3L > hH : h3H < hL)
                    s.kill("Excluded: wick begins unfilled imbalance")
                s.fvgChecked := true

        // generic invalidation before an order exists
        if s.state >= S_LIQ and s.state <= S_LTF
            if through
                s.kill("Invalid: HTF wick extreme traded through")
            else if tgtTaken
                s.kill("Invalid: destination already traded")
            else if s.state != S_LTF and s.htfAge > maxHtfAge
                s.kill("Expired")

        // 1) engineered liquidity before CE
        if s.state == S_LIQ
            if ceTouch
                s.kill("Invalid: CE reached before liquidity formed")
            else
                float piv = d == -1 ? ph : pl
                if not na(piv) and pivT >= s.startTime
                    float dist = d == -1 ? s.ce - piv : piv - s.ce
                    if dist <= proxPts
                        s.kill("Excluded: liquidity within " + str.tostring(proxPts) + " pts of CE")
                    else if dist <= liqMaxDist
                        s.liqCount := s.liqCount + 1
                        s.liqLevel := piv
                        s.note     := "Liquidity " + str.tostring(s.liqCount) + "/" + str.tostring(minLiq)
                        if showLevels
                            label.new(pivT, piv, "$", xloc = xloc.bar_time, style = label.style_none, textcolor = colLiq, size = size.small)
                if s.state == S_LIQ and s.liqCount >= minLiq
                    if s.fvgChecked
                        s.state := S_READY
                        s.note  := "Qualified - " + (setupMode == SETUP1 ? "awaiting order" : "awaiting CE")
                    else
                        s.note := "Liquidity OK - waiting imbalance check"

        // 2) ready
        if s.state == S_READY
            if setupMode == SETUP1
                if ceTouch
                    s.kill("Missed: CE reached before order placed")
                else if canTrade
                    s.planOrder(s.ce, s.ext - d * stopBuf, "S1")
            else
                if ceTouch
                    s.state    := S_LTF
                    s.reachBar := bar_index
                    s.note     := "CE reached - waiting LTF rejection"

        // 3) setup 2: chart-TF rejection block at the HTF CE
        if s.state == S_LTF
            if through
                s.kill("Invalid: HTF wick extreme traded through")
            else
                float bodyEdge = d == -1 ? math.max(open, close) : math.min(open, close)
                float wExt     = d == -1 ? high : low
                float w        = math.abs(wExt - bodyEdge)
                float rng      = high - low
                bool atArea    = d == -1 ? high >= s.ce : low <= s.ce
                bool dirOk     = not ltfDirCls or (d == -1 ? close < open : close > open)
                bool rej       = atArea and rng > 0 and w >= ltfMinPts and w / rng * 100 >= ltfMinPct and dirOk
                if rej and canTrade
                    float wCe = (wExt + bodyEdge) / 2
                    s.planOrder(ltfRef == "Wick CE (50%)" ? wCe : bodyEdge, wExt - d * stopBuf, "S2")
                else if bar_index - s.reachBar >= ltfWait
                    s.kill("Missed: no LTF rejection formed")

        // 4) working order
        if s.state == S_ORDER and bar_index > s.orderBar
            bool filled = d == -1 ? high >= s.entry : low <= s.entry
            if filled
                s.state := S_DONE
                s.note  := "Filled"
            else if tgtTaken
                s.kill("Cancelled: destination traded before fill")
            else if through
                s.kill("Cancelled: HTF extreme traded through")
            else if dayLocked
                s.kill("Cancelled: daily limit reached")
            else if bar_index - s.orderBar > orderExp
                s.kill("Cancelled: limit expired")
        s.extendLines()
    s

// ───────────────────────────── Candidate detection on HTF close ─────────────────────────────
var Setup bear = Setup.new(dir = -1)
var Setup bull = Setup.new(dir = 1)

if newHtf and not na(hPH) and not na(pdH)
    float rng = hH - hL
    // bearish upper wick
    float bBeg = math.max(hO, hC)
    float bW   = hH - bBeg
    bool bOrig = originMode == "Any qualified wick" or (hH > hPH and hC < hPH)
    bool bEq   = useEqFilt and math.abs(hH - hPH) <= eqTol
    bool bTgt  = targetMode == TGT_R or (dayLo > pdL and pdL < (bBeg + hH) / 2)
    if allowShort and rng > 0 and bW >= minWickPts and bW / rng * 100 >= minWickPct and bOrig and not bEq and bTgt
        if bear.state != S_ORDER and bear.state != S_LTF
            if bear.alive()
                bear.kill("Replaced by newer wick")
            bear := f_newSetup(-1, hT, bBeg, hH, pdL)
    // bullish lower wick
    float uBeg = math.min(hO, hC)
    float uW   = uBeg - hL
    bool uOrig = originMode == "Any qualified wick" or (hL < hPL and hC > hPL)
    bool uEq   = useEqFilt and math.abs(hL - hPL) <= eqTol
    bool uTgt  = targetMode == TGT_R or (dayHi < pdH and pdH > (uBeg + hL) / 2)
    if allowLong and rng > 0 and uW >= minWickPts and uW / rng * 100 >= minWickPct and uOrig and not uEq and uTgt
        if bull.state != S_ORDER and bull.state != S_LTF
            if bull.alive()
                bull.kill("Replaced by newer wick")
            bull := f_newSetup(1, hT, uBeg, hL, pdH)

// ───────────────────────────── Run state machines ─────────────────────────────
bool baseOk = inSess and not dayLocked and strategy.position_size == 0
bear.step(baseOk and bull.state != S_ORDER)
bull.step(baseOk and bear.state != S_ORDER)

// ───────────────────────────── Position management ─────────────────────────────
var string pId    = ""
var float  pEntry = na
var float  pStop  = na
var float  pTp    = na
var float  pRisk  = na
var bool   beDone = false
var int    pTime  = na
var float  swHi      = na
var float  swLo      = na
var float  swHiAfter = na
var float  swLoAfter = na

if strategy.position_size == 0
    pId := ""
else if strategy.opentrades > 0 and strategy.opentrades.entry_id(0) != pId
    pId    := strategy.opentrades.entry_id(0)
    pEntry := strategy.opentrades.entry_price(0)
    Setup src = bear.id == pId ? bear : bull
    pStop  := src.stop
    pTp    := src.tp
    pRisk  := math.abs(pEntry - pStop)
    beDone := false
    pTime  := time
    swHi      := na
    swLo      := na
    swHiAfter := na
    swLoAfter := na
    // never let an opposite pending order reverse the position
    if bear.state == S_ORDER and bear.id != pId
        bear.kill("Cancelled: other position filled")
    if bull.state == S_ORDER and bull.id != pId
        bull.kill("Cancelled: other position filled")

if strategy.position_size != 0 and pId != ""
    int   pd      = strategy.position_size > 0 ? 1 : -1
    float oldStop = pStop
    // break-even
    if beAtR > 0 and not beDone and pRisk > 0
        float fav = pd == 1 ? high - pEntry : pEntry - low
        if fav >= beAtR * pRisk
            pStop  := pd == 1 ? math.max(pStop, pEntry) : math.min(pStop, pEntry)
            beDone := true
    // structural trail: a swing low (long) is confirmed once price breaks the intervening swing high
    if useTrail
        if not na(ph) and pivT >= pTime
            swHi      := ph
            swLoAfter := na
            if not na(swLo)
                swHiAfter := ph
        if not na(pl) and pivT >= pTime
            swLo      := pl
            swHiAfter := na
            if not na(swHi)
                swLoAfter := pl
        if pd == 1 and not na(swLo) and not na(swHiAfter) and close > swHiAfter
            float ns = swLo - stopBuf
            if ns > pStop and ns < close
                pStop := ns
            swHiAfter := na
        if pd == -1 and not na(swHi) and not na(swLoAfter) and close < swLoAfter
            float ns = swHi + stopBuf
            if ns < pStop and ns > close
                pStop := ns
            swLoAfter := na
    if pStop != oldStop
        strategy.exit(pId + " x", from_entry = pId, stop = pStop, limit = pTp, comment_loss = "SL", comment_profit = "TP")

// ───────────────────────────── Visuals ─────────────────────────────
plot(showPD ? pdH : na, "Prior day high", color = color.new(colBull, 40), style = plot.style_stepline)
plot(showPD ? pdL : na, "Prior day low",  color = color.new(colBear, 40), style = plot.style_stepline)
plot(strategy.position_size != 0 ? pStop : na, "Active stop", color = color.red,   style = plot.style_linebr)
plot(strategy.position_size != 0 ? pTp   : na, "Active target", color = color.lime, style = plot.style_linebr)

f_stateName(Setup s) =>
    s.state == S_LIQ ? "Waiting liquidity" : s.state == S_READY ? "Qualified" : s.state == S_LTF ? "Waiting LTF rejection" :
     s.state == S_ORDER ? "Order working" : "Idle"

var table tbl = table.new(position.top_right, 2, 6, bgcolor = color.new(chart.bg_color, 10), border_width = 1, border_color = color.gray)
if showTable and barstate.islast
    string biasTxt = dailyBias == 1 ? "Bullish" : dailyBias == -1 ? "Bearish" : "Unclear"
    table.cell(tbl, 0, 0, "Route", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 0, setupMode, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 1, "Daily bias", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 1, biasTxt, text_color = dailyBias == 1 ? colBull : dailyBias == -1 ? colBear : chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 2, "Short setup", text_color = colBear, text_size = size.small)
    table.cell(tbl, 1, 2, f_stateName(bear) + (bear.note != "" ? " | " + bear.note : ""), text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 3, "Long setup", text_color = colBull, text_size = size.small)
    table.cell(tbl, 1, 3, f_stateName(bull) + (bull.note != "" ? " | " + bull.note : ""), text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 4, "Trades / losses today", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 4, str.tostring(tradesToday) + "/" + str.tostring(maxTrades) + "  |  " + str.tostring(lossesToday) + "/" + str.tostring(maxLosses), text_color = dayLocked ? color.red : chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 5, "PDH / PDL", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 5, str.tostring(pdH, format.mintick) + " / " + str.tostring(pdL, format.mintick), text_color = chart.fg_color, text_size = size.small)
